# CẤU HÌNH MÔI TRƯỜNG MẪU (CYBER AGENT PRO)
# Hãy sao chép file này thành .env và điền các khóa bí mật của bạn:

# Cổng máy chủ backend (mặc định: 3000)
PORT=3000

# Khóa bí mật Google Gemini API (Bắt buộc)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Thư mục gốc lưu trữ sản phẩm xuất ra
OUTPUT_DIR=C:\Users\Nam\Desktop\gemini

# Cấu hình AI bên ngoài / Tùy chỉnh (Tùy chọn)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_KEY=

