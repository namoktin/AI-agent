# CẤU HÌNH MÔI TRƯỜNG (CYBER AGENT PRO)
# Sao chép file này thành .env và điền các khóa bí mật của bạn:
#   cp .env.example .env

# Cổng máy chủ backend (mặc định: 3000)
PORT=3000

# Khóa bí mật Google Gemini API (Bắt buộc)
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Khóa bảo mật xác thực API (Khuyến nghị bật khi triển khai)
# Khi chưa cấu hình: server chỉ cho phép kết nối từ localhost
AGENT_SECRET_KEY=

# Thư mục gốc lưu trữ sản phẩm xuất ra (tùy chọn)
OUTPUT_DIR=

# Cấu hình AI bên ngoài / Tùy chỉnh (Tùy chọn)
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=
CUSTOM_AI_KEY=
